{
  "schema": 1,
  "repository": "4alvit/fastapi-mqtt-gateway",
  "mode": "release",
  "default_branch": "main",
  "validation_workflows": [
    "ci.yml",
    "codeql.yml",
    "release-security.yml",
    "dependency-review.yml"
  ],
  "artifact_pattern": "release-assets*",
  "version_file": "pyproject.toml",
  "local_checks": [
    "bash scripts/ci.sh",
    "bash scripts/ci.sh security"
  ],
  "notes": [
    "Existing coverage threshold is zero; unit tests still must pass."
  ],
  "container_assets": {
    "fastapi-mqtt-gateway-container.oci.tar": "ghcr.io/4alvit/fastapi-mqtt-gateway"
  },
  "visibility": "public",
  "single_entry_ci": true,
  "release_notes": "CHANGELOG.md",
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "pyproject.toml",
        "format": "toml",
        "field": "project.version",
        "package": "fastapi-mqtt-gateway",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "uv.lock",
        "format": "uv-lock",
        "package": "fastapi-mqtt-gateway",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "src/fastapi_mqtt_gateway/_version.py",
        "format": "python",
        "field": "__version__",
        "value": "package",
        "ecosystem": "pep440"
      }
    ],
    "artifacts": [
      {
        "path": "fastapi-mqtt-gateway-*.tar.gz",
        "format": "tar-toml",
        "member": "fastapi-mqtt-gateway/pyproject.toml",
        "field": "project.version",
        "package": "fastapi-mqtt-gateway",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "fastapi-mqtt-gateway-container.oci.tar",
        "format": "oci",
        "field": [
          "config",
          "Labels",
          "org.opencontainers.image.version"
        ],
        "value": "package"
      }
    ],
    "toolkit_revision": "5b498755c6357b034be0221f51633bab69e2380e"
  },
  "fuzzing": {
    "toolkit_ref": "5b498755c6357b034be0221f51633bab69e2380e"
  }
