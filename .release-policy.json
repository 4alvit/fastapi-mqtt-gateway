{
  "schema": 1,
  "repository": "4alvit/fastapi-mqtt-gateway",
  "mode": "release",
  "default_branch": "main",
  "validation_workflows": [
    "ci.yml",
    "codeql.yml",
    "release-security.yml"
  ],
  "artifact_pattern": "release-assets*",
  "version_file": "pyproject.toml",
  "local_checks": [
    "bash scripts/ci.sh",
    "bash scripts/ci.sh security"
  ],
  "notes": [
    "Existing coverage threshold is zero; unit tests still must pass."
  ],
  "container_assets": {
    "fastapi-mqtt-gateway-container.oci.tar": "ghcr.io/4alvit/fastapi-mqtt-gateway"
  }
}
