{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "docker-compose",
    "dockerfile",
    "pep621",
    "pip_requirements",
    "pip-compile"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.(txt|pip)$/"
    ],
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      ".github/requirements-fuzz.txt",
      ".github/requirements-fuzz.in"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^\\.github/requirements\\-fuzz\\.txt$/"
    ]
  }
}
