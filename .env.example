# Application Configuration
APP_NAME = "FastAPI MQTT Gateway"
APP_VERSION = "0.1.0"
DEBUG = false

# Server Configuration
HOST = "0.0.0.0"
PORT = 8000

# MQTT Broker Configuration
MQTT_BROKER_HOST = "mqtt-broker"
MQTT_BROKER_PORT = 1883
MQTT_USERNAME = ""
MQTT_PASSWORD = ""
MQTT_CLIENT_ID = "fastapi-mqtt-gateway"
MQTT_KEEPALIVE = 60
MQTT_CLEAN_SESSION = true
MQTT_USE_TLS = false
MQTT_CA_CERTS = ""
MQTT_CERTFILE = ""
MQTT_KEYFILE = ""

# Required API credentials (independent of MQTT). Generate random values before startup.
API_USERNAME = "gateway"
API_PASSWORD = ""

# Required JWT signing secret: openssl rand -hex 32
JWT_SECRET_KEY = ""
JWT_ALGORITHM = "HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 30
JWT_REFRESH_TOKEN_EXPIRE_DAYS = 7

# CORS
CORS_ALLOWED_ORIGINS = []

# Rate Limiting
RATE_LIMIT_ENABLED = true
RATE_LIMIT_REQUESTS = 100
RATE_LIMIT_WINDOW_SECONDS = 60

# Topic Management
DEFAULT_TOPIC_PREFIX = "gateway"
ALLOWED_TOPIC_PATTERNS = ["#"]
BLOCKED_TOPIC_PATTERNS = ["$SYS/#", "$share/#"]

# Retained Message Query
RETAINED_QUERY_TIMEOUT = 5.0

# Logging
LOG_LEVEL = "INFO"
LOG_FORMAT = "json"
